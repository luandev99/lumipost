  "templateType": "carousel",
  "schemaVersion": "2.0",
  "carouselSlideType": "closing",
  "contentRequirements": {
    "hasList": false,
    "textVariables": [
      "headline"
    ],
    "businessFields": [
      "logo"
    ],
    "hasImagePlaceholder": true
