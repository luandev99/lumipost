{
  "props": {
    "bgColor1": "#000000",
    "bgColor2": "#f5f0e8",
    "bgColor3": "#333333",
    "textColor1": "#333333",
    "textColor2": "#666666",
    "textColor3": "#333333"
  },
  "layers": [
    {
      "id": "background",
      "type": "container",
      "styles": {
        "backgroundColor": "{{bgColor1}}"
      },
      "zIndex": 0,
      "position": {
        "top": "0",
        "left": "0",
        "type": "absolute",
        "width": "100%",
        "height": "100%"
      },
      "editorMeta": {
        "name": "Background",
        "locked": true,
        "isBackground": true
      }
    },
    {
      "id": "layer_main_image",
      "type": "image",
      "styles": {
        "objectFit": "cover",
        "backgroundColor": "#F0F0F0"
      },
      "zIndex": 1,
      "content": {
        "alt": "Imagem de fundo",
        "source": "{{mainImage}}"
      },
      "position": {
        "top": "0",
        "left": "0",
        "type": "absolute",
        "width": "100%",
        "height": "100%"
      },
      "editorMeta": {
        "name": "Imagem de Fundo",
        "locked": true
      }
    },
    {
      "id": "layer_card",
      "type": "container",
      "styles": {
        "backgroundColor": "{{bgColor2}}"
      },
      "zIndex": 2,
      "position": {
        "top": "calc(var(--image-height-post) * 0.18)",
        "left": "calc(var(--image-width) * 0.18)",
        "type": "absolute",
        "width": "calc(var(--image-width) * 0.64)",
        "height": "calc(var(--image-height-post) * 0.28)"
      },
      "editorMeta": {
        "name": "Card"
      }
    },
    {
      "id": "layer_headline",
      "type": "text",
      "styles": {
        "color": "{{textColor1}}",
        "fontSize": "calc(var(--image-width) * 0.042)",
        "fontStyle": "italic",
        "textAlign": "center",
        "fontFamily": "{{textFont1}}",
        "fontWeight": "400",
        "lineHeight": "1.4",
        "verticalAlign": "middle"
      },
      "zIndex": 3,
      "autoFit": {
        "mode": "scale",
        "enabled": true,
        "maxFontSize": "6%",
        "minFontSize": "2%",
        "lineHeightRatio": 1.4
      },
      "content": {
        "text": "{{headline}}"
      },
      "editable": true,
      "position": {
        "top": "calc(var(--image-height-post) * 0.22)",
        "left": "calc(var(--image-width) * 0.22)",
        "type": "absolute",
        "width": "calc(var(--image-width) * 0.56)",
        "height": "calc(var(--image-height-post) * 0.20)"
      },
      "fieldName": "img_content_headline",
      "editorMeta": {
        "name": "Headline"
      }
    }
  ],
  "packageId": "pacote-novo",
  "dimensions": {
    "width": 1080,
    "height": 1350
  },
  "templateId": "back-cover-with-citation-2",
  "aspectRatio": "1:1.25",
