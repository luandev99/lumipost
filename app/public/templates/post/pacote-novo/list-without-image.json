{
  "props": {
    "bgColor1": "#7a6a4a",
    "bgColor2": "#f5f0e8",
    "bgColor3": "#9a8ac8",
    "textColor1": "#f5f0e8",
    "textColor2": "#3d3d3d",
    "textColor3": "#f5f0e8"
  },
  "layers": [
    {
      "id": "background",
      "type": "container",
      "styles": {
        "backgroundColor": "{{bgColor1}}"
      },
      "zIndex": 0,
      "position": {
        "top": "0",
        "left": "0",
        "type": "absolute",
        "width": "100%",
        "height": "100%"
      },
      "editorMeta": {
        "name": "Background",
        "locked": true,
        "isBackground": true
      }
    },
    {
      "id": "layer_headline",
      "type": "text",
      "styles": {
        "color": "{{textColor1}}",
        "fontSize": "calc(var(--image-width) * 0.08)",
        "fontStyle": "italic",
        "textAlign": "center",
        "fontFamily": "{{textFont1}}",
        "fontWeight": "400",
        "lineHeight": "1.1",
        "verticalAlign": "middle"
      },
      "zIndex": 10,
      "autoFit": {
        "mode": "scale",
        "enabled": true,
        "maxFontSize": "12%",
        "minFontSize": "2%",
        "lineHeightRatio": 1.1
      },
      "content": {
        "text": "{{headline}}"
      },
      "editable": true,
      "position": {
        "top": "calc(var(--image-height-post) * 0.08)",
        "left": "calc(var(--image-width) * 0.1)",
        "type": "absolute",
        "width": "calc(var(--image-width) * 0.8)",
        "height": "calc(var(--image-height-post) * 0.15)"
      },
      "fieldName": "img_content_headline",
      "editorMeta": {
        "name": "Headline"
      }
    },
    {
      "id": "layer_subtitle",
      "type": "text",
      "styles": {
        "color": "{{textColor1}}",
        "fontSize": "calc(var(--image-width) * 0.035)",
        "fontStyle": "italic",
        "textAlign": "center",
        "fontFamily": "{{textFont2}}",
        "fontWeight": "400",
        "lineHeight": "1.4",
        "verticalAlign": "middle"
      },
      "zIndex": 11,
      "content": {
        "text": "{{subtitle}}"
      },
      "editable": true,
      "position": {
        "top": "calc(var(--image-height-post) * 0.24)",
        "left": "calc(var(--image-width) * 0.2)",
        "type": "absolute",
        "width": "calc(var(--image-width) * 0.6)",
        "height": "calc(var(--image-height-post) * 0.05)"
      },
      "fieldName": "img_content_subtitle",
      "editorMeta": {
        "name": "Subtítulo"
      }
    },
    {
      "id": "layer_list",
      "type": "list-container",
      "zIndex": 15,
      "position": {
        "top": "calc(var(--image-height-post) * 0.32)",
        "left": "calc(var(--image-width) * 0.12)",
        "type": "absolute",
        "width": "calc(var(--image-width) * 0.76)",
        "height": "calc(var(--image-height-post) * 0.48)"
      },
      "editorMeta": {
        "name": "Lista"
      },
      "listConfig": {
        "columns": 1,
        "itemGap": "calc(var(--image-width) * 0.06)",
        "iconSize": "calc(var(--image-width) * 0.01)",
        "maxItems": 4,
        "iconColor": "{{bgColor3}}",
        "iconStyle": "none",
        "itemAlign": "center",
        "textStyles": {
          "color": "{{textColor1}}",
          "padding": "calc(var(--image-width) * 0.025) calc(var(--image-width) * 0.08)",
          "fontSize": "calc(var(--image-width) * 0.035)",
          "textAlign": "center",
          "fontFamily": "{{textFont2}}",
          "fontWeight": "400",
          "lineHeight": "1.3",
          "borderRadius": "50px",
          "backgroundColor": "{{bgColor3}}"
        },
        "iconTextGap": "calc(var(--image-width) * 0.03)",
        "startNumber": 1,
        "iconStrokeWidth": 2,
        "itemVariablePrefix": "contentList"
      }
    },
    {
      "id": "layer_cta",
      "type": "text",
      "styles": {
        "color": "{{textColor1}}",
        "fontSize": "calc(var(--image-width) * 0.035)",
        "fontStyle": "italic",
        "textAlign": "center",
        "fontFamily": "{{textFont2}}",
        "fontWeight": "400",
        "lineHeight": "1.4",
        "verticalAlign": "middle"
      },
      "zIndex": 11,
      "content": {
        "text": "{{ctaText}}"
      },
      "editable": true,
      "position": {
        "top": "calc(var(--image-height-post) * 0.82)",
        "left": "calc(var(--image-width) * 0.2)",
        "type": "absolute",
        "width": "calc(var(--image-width) * 0.6)",
        "height": "calc(var(--image-height-post) * 0.05)"
      },
      "fieldName": "img_content_cta",
      "editorMeta": {
        "name": "CTA"
      }
    }
  ],
  "packageId": "pacote-novo",
  "dimensions": {
    "width": 1080,
    "height": 1350
  },
  "templateId": "list-without-image",
  "aspectRatio": "1:1.25",
  "templateName": "list-without-image",
  "templateType": "post",
  "schemaVersion": "2.0",
  "contentRequirements": {
    "hasList": true,
    "maxListItems": 4,
    "textVariables": [
      "headline",
      "subtitle",
      "ctaText",
      "contentList"
    ],
    "businessFields": [
      "logo"
    ],
    "hasImagePlaceholder": false
  }
}