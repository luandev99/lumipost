{
  "name": "main-text-and-subtitle-with-image",
  "props": {
    "bgColor1": "#3D2E1E",
    "bgColor2": "#FFFFFF",
    "bgColor3": "#A67C52",
    "textColor1": "#FFFFFF",
    "textColor2": "#F5F0EB",
    "textColor3": "#A67C52"
  },
  "layers": [
    {
      "id": "background",
      "type": "container",
      "styles": {
        "backgroundColor": "{{bgColor1}}"
      },
      "zIndex": 0,
      "position": {
        "top": "0",
        "left": "0",
        "type": "absolute",
        "width": "100%",
        "height": "100%"
      },
      "editorMeta": {
        "name": "Background",
        "locked": true,
        "isBackground": true
      }
    },
    {
      "id": "layer_main_image",
      "type": "image",
      "styles": {
        "opacity": "0.55",
        "objectFit": "cover",
        "backgroundColor": "#F0F0F0"
      },
      "zIndex": 1,
      "content": {
        "alt": "Imagem principal",
        "source": "{{mainImage}}"
      },
      "position": {
        "top": "0",
        "left": "0",
        "type": "absolute",
        "width": "100%",
        "height": "100%"
      },
      "editorMeta": {
        "name": "Main Image",
        "locked": true
      }
    },
    {
      "id": "layer_overlay",
      "type": "container",
      "styles": {
        "opacity": "0.45",
        "backgroundColor": "{{bgColor1}}"
      },
      "zIndex": 2,
      "position": {
        "top": "0",
        "left": "0",
        "type": "absolute",
        "width": "100%",
        "height": "100%"
      },
      "editorMeta": {
        "name": "Overlay"
      }
    },
    {
      "id": "layer_headline",
      "type": "text",
      "styles": {
        "color": "{{textColor1}}",
        "fontSize": "calc(var(--image-width) * 0.075)",
        "textAlign": "center",
        "fontFamily": "{{textFont1}}",
        "fontWeight": "700",
        "lineHeight": "1.2",
        "verticalAlign": "middle"
      },
      "zIndex": 4,
      "autoFit": {
        "mode": "scale",
        "enabled": true,
        "maxFontSize": "12%",
        "minFontSize": "2%",
        "lineHeightRatio": 1.2
      },
      "content": {
        "text": "{{headline}}"
      },
      "editable": true,
      "position": {
        "top": "calc(var(--image-height-story) * 0.32)",
        "left": "calc(var(--image-width) * 0.08)",
        "type": "absolute",
        "width": "calc(var(--image-width) * 0.84)",
        "height": "calc(var(--image-height-story) * 0.2)"
      },
      "fieldName": "img_content_headline",
      "editorMeta": {
        "name": "Headline"
      }
    },
    {
      "id": "layer_subtitle",
      "type": "text",
      "styles": {
        "color": "{{textColor2}}",
        "fontSize": "calc(var(--image-width) * 0.038)",
        "fontStyle": "italic",
        "textAlign": "center",
        "fontFamily": "{{textFont2}}",
        "fontWeight": "400",
        "lineHeight": "1.4",
        "verticalAlign": "middle"
      },
      "zIndex": 5,
      "autoFit": {
        "mode": "scale",
        "enabled": true,
        "maxFontSize": "8%",
        "minFontSize": "2%",
        "lineHeightRatio": 1.4
      },
      "content": {
        "text": "{{subtitle}}"
      },
      "editable": true,
      "position": {
        "top": "calc(var(--image-height-story) * 0.55)",
        "left": "calc(var(--image-width) * 0.12)",
        "type": "absolute",
        "width": "calc(var(--image-width) * 0.76)",
        "height": "calc(var(--image-height-story) * 0.12)"
      },
      "fieldName": "img_content_subtitle",
      "editorMeta": {
        "name": "Subtitle"
      }
    },
    {
      "id": "layer_logo_bg",
      "type": "container",
      "styles": {
        "borderRadius": "18px",
        "backgroundColor": "{{bgColor2}}"
      },
      "zIndex": 8,
      "position": {
        "top": "calc(var(--image-height-story) * 0.92)",
        "left": "calc(var(--image-width) * 0.32)",
        "type": "absolute",
        "width": "calc(var(--image-width) * 0.36)",
        "height": "calc(var(--image-height-story) * 0.055)"
      },
      "editorMeta": {
        "name": "Logo Background"
      }
    },
    {
      "id": "layer_logo",
      "type": "image",
      "styles": {
        "objectFit": "contain"
      },
      "zIndex": 9,
      "content": {
        "alt": "Logo",
        "source": "{{businessLogo}}"
      },
      "position": {
        "top": "calc(var(--image-height-story) * 0.925)",
        "left": "calc(var(--image-width) * 0.35)",
        "type": "absolute",
        "width": "calc(var(--image-width) * 0.30)",
        "height": "calc(var(--image-height-story) * 0.045)"
      },
      "editorMeta": {
        "name": "Logo"
      }
    }
  ],
  "packageId": "pacote-novo",
  "dimensions": {
    "width": 1080,
    "height": 1920
  },
  "templateId": "main-text-and-subtitle-with-image",
  "aspectRatio": "9:16",
  "templateName": "main-text-and-subtitle-with-image",
  "templateType": "story",
  "schemaVersion": "2.0",
  "contentRequirements": {
    "hasList": false,
    "textVariables": [
      "headline",
      "subtitle"
    ],
    "businessFields": [
      "logo"
    ],
    "hasImagePlaceholder": true
  }
}