{
  "name": "numbered-list-without-image",
  "props": {
    "bgColor1": "#F5F0EB",
    "bgColor2": "#3D2E1E",
    "bgColor3": "#A67C52",
    "textColor1": "#3D2E1E",
    "textColor2": "#5C4A3A",
    "textColor3": "#A67C52"
  },
  "layers": [
    {
      "id": "background",
      "type": "container",
      "styles": {
        "backgroundColor": "{{bgColor1}}"
      },
      "zIndex": 0,
      "position": {
        "top": "0",
        "left": "0",
        "type": "absolute",
        "width": "100%",
        "height": "100%"
      },
      "editorMeta": {
        "name": "Background",
        "locked": true,
        "isBackground": true
      }
    },
    {
      "id": "layer_headline",
      "type": "text",
      "styles": {
        "color": "{{textColor1}}",
        "fontSize": "calc(var(--image-width) * 0.07)",
        "textAlign": "center",
        "fontFamily": "{{textFont1}}",
        "fontWeight": "700",
        "lineHeight": "1.2",
        "verticalAlign": "middle"
      },
      "zIndex": 2,
      "autoFit": {
        "mode": "scale",
        "enabled": true,
        "maxFontSize": "10%",
        "minFontSize": "2%",
        "lineHeightRatio": 1.2
      },
      "content": {
        "text": "{{headline}}"
      },
      "editable": true,
      "position": {
        "top": "calc(var(--image-height-story) * 0.10)",
        "left": "calc(var(--image-width) * 0.08)",
        "type": "absolute",
        "width": "calc(var(--image-width) * 0.84)",
        "height": "calc(var(--image-height-story) * 0.15)"
      },
      "fieldName": "img_content_headline",
      "editorMeta": {
        "name": "Headline"
      }
    },
    {
      "id": "layer_list",
      "type": "list-container",
      "zIndex": 3,
      "position": {
        "top": "calc(var(--image-height-story) * 0.30)",
        "left": "calc(var(--image-width) * 0.08)",
        "type": "absolute",
        "width": "calc(var(--image-width) * 0.84)",
        "height": "calc(var(--image-height-story) * 0.56)"
      },
      "editorMeta": {
        "name": "Lista Numerada"
      },
      "listConfig": {
        "columns": 1,
        "itemGap": "calc(var(--image-width) * 0.06)",
        "iconSize": "calc(var(--image-width) * 0.05)",
        "maxItems": 5,
        "iconColor": "{{bgColor3}}",
        "iconStyle": "number",
        "itemAlign": "left",
        "textStyles": {
          "color": "{{textColor2}}",
          "fontSize": "calc(var(--image-width) * 0.036)",
          "textAlign": "left",
          "fontFamily": "{{textFont2}}",
          "fontWeight": "400",
          "lineHeight": "1.3"
        },
        "iconTextGap": "calc(var(--image-width) * 0.03)",
        "startNumber": 1,
        "iconStrokeWidth": 1,
        "itemVariablePrefix": "contentList"
      }
    },
    {
      "id": "layer_logo_bg",
      "type": "container",
      "styles": {
        "borderRadius": "18px",
        "backgroundColor": "{{bgColor2}}"
      },
      "zIndex": 8,
      "position": {
        "top": "calc(var(--image-height-story) * 0.92)",
        "left": "calc(var(--image-width) * 0.32)",
        "type": "absolute",
        "width": "calc(var(--image-width) * 0.36)",
        "height": "calc(var(--image-height-story) * 0.055)"
      },
      "editorMeta": {
        "name": "Logo Background"
      }
    },
    {
      "id": "layer_logo",
      "type": "image",
      "styles": {
        "objectFit": "contain"
      },
      "zIndex": 9,
      "content": {
        "alt": "Logo",
        "source": "{{businessLogo}}"
      },
      "position": {
        "top": "calc(var(--image-height-story) * 0.925)",
        "left": "calc(var(--image-width) * 0.35)",
        "type": "absolute",
        "width": "calc(var(--image-width) * 0.30)",
        "height": "calc(var(--image-height-story) * 0.045)"
      },
      "editorMeta": {
        "name": "Logo"
      }
    }
  ],
  "packageId": "pacote-novo",
  "dimensions": {
    "width": 1080,
    "height": 1920
  },
  "templateId": "numbered-list-without-image",
  "aspectRatio": "9:16",
  "templateName": "numbered-list-without-image",
  "templateType": "story",
  "schemaVersion": "2.0",
  "contentRequirements": {
    "hasList": true,
    "maxListItems": 5,
    "textVariables": [
      "headline",
      "contentList"
    ],
    "businessFields": [
      "logo"
    ],
    "hasImagePlaceholder": false
  }
}