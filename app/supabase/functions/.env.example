# Server-side names only. Put real values in Supabase Edge Function Secrets.
# Never prefix these with VITE_ and never commit a populated .env file.
OPENAI_API_KEY=replace_in_supabase_dashboard
# gpt-5.6-terra é o substituto oficial da OpenAI para gpt-5-mini, que
# será desligado em 2026 (https://developers.openai.com/api/docs/deprecations).
# Confira preço/linhagem atual antes de trocar: developers.openai.com/api/docs/pricing
OPENAI_IDENTITY_MODEL=gpt-5.6-terra
OPENAI_CONTENT_MODEL=gpt-5.6-terra
# gpt-image-2 é o substituto oficial da OpenAI para gpt-image-1-mini,
# que também será desligado em 2026 (mesma página de deprecações acima).
OPENAI_IMAGE_MODEL=gpt-image-2
HIGGSFIELD_API_KEY=replace_only_after_official_server_access
APP_URL=http://localhost:5173
STRIPE_SECRET_KEY=replace_in_supabase_dashboard
STRIPE_WEBHOOK_SECRET=replace_in_supabase_dashboard
STRIPE_PRICE_MONTH=replace_in_supabase_dashboard
STRIPE_PRICE_YEAR=replace_in_supabase_dashboard
STRIPE_PRICE_CREDITS_50=replace_in_supabase_dashboard
STRIPE_PRICE_CREDITS_150=replace_in_supabase_dashboard
STRIPE_PRICE_CREDITS_400=replace_in_supabase_dashboard
META_INSTAGRAM_APP_ID=replace_in_supabase_dashboard
META_INSTAGRAM_APP_SECRET=replace_in_supabase_dashboard
META_REDIRECT_URI=http://127.0.0.1:54321/functions/v1/meta-oauth-callback
META_GRAPH_VERSION=replace_with_current_supported_version
PUBLISH_WORKER_SECRET=replace_with_at_least_32_random_bytes
ALLOWED_ORIGINS=http://localhost:5173,https://lumipost-ai.vercel.app
